# Local test build of the installed app against the Emulator Suite:
#   npm run build:e2e -w web && npx vite preview --port 4173 (in web/)
# Never deployable: a demo- project is refused by the build guard unless this
# file's VITE_USE_EMULATORS=true is set, and that is refused for real projects.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-expense-splitter.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-expense-splitter
VITE_FIREBASE_STORAGE_BUCKET=demo-expense-splitter.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_USE_EMULATORS=true
