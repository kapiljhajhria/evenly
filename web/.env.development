# Emulator profile. Vite loads this automatically for `npm run dev`.
# A "demo-" project id keeps the Emulator Suite from asking for credentials,
# and the api key is a placeholder the Auth emulator ignores.
# Put real Firebase config in web/.env.local (gitignored) to hit live Firebase.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-expense-splitter.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-expense-splitter
VITE_FIREBASE_STORAGE_BUCKET=demo-expense-splitter.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
