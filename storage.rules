rules_version = '2';

// Receipts live at receipts/{groupId}/{expenseId}.{ext}. Group members only,
// images only, and the path must point at a real expense in that group.
service firebase.storage {
  match /b/{bucket}/o {

    function isMember(groupId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.uids;
    }

    function expenseExists(groupId, expenseId) {
      return firestore.exists(/databases/(default)/documents/groups/$(groupId)/expenses/$(expenseId));
    }

    // The client only ever produces {expenseId}.webp, or .jpg where the
    // browser cannot encode WebP — and the extension must match the type.
    function receiptFile(fileName) {
      return (fileName.matches('^[A-Za-z0-9_-]+[.]webp$') && request.resource.contentType == 'image/webp')
        || (fileName.matches('^[A-Za-z0-9_-]+[.]jpg$') && request.resource.contentType == 'image/jpeg');
    }

    match /receipts/{groupId}/{fileName} {
      allow read: if isMember(groupId);

      // create + update only: `write` would include delete.
      allow create, update: if isMember(groupId)
        && receiptFile(fileName)
        && expenseExists(groupId, fileName.split('[.]')[0])
        && request.resource.size <= 1 * 1024 * 1024;

      // onExpenseWrite / deleteGroup handle removal.
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
